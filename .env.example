APP_NAME=Washy Washy API
SERVICE_NAME=washy-washy
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=washy_washy
